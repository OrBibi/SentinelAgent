# Backend that SentinelAgent protects
UPSTREAM_BASE_URL=http://localhost:9000

# Redis connection; use memory:// for a single-process in-memory Redis (no Docker needed)
REDIS_URL=redis://localhost:6379/0

# Behavior when Redis is unreachable: "open" (forward and log) or "closed" (deny with 503)
FAIL_MODE=open

# Meta open-weight model via Baseten (OpenAI-compatible Chat Completions)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Use meta-models/muse-spark-open if the dated slug is not enabled for your workspace
BASETEN_MODEL=meta-models/muse-spark-open-1026
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2

# Fast filter thresholds (0..1 risk score)
SUSPICIOUS_THRESHOLD=0.45
HARD_BLOCK_THRESHOLD=0.9

# Sliding-window rate limiting
RATE_WINDOW_SECONDS=10
RATE_LIMIT_PER_WINDOW=50

# BOLA: distinct object IDs per client and route template within the window
BOLA_WINDOW_SECONDS=60
BOLA_DISTINCT_THRESHOLD=15

# Session history length kept per client for the agent prompt
HISTORY_SIZE=25

# Agent mitigation policy
BLOCK_CONFIDENCE=0.85
CRITICAL_THREAT_CONFIDENCE=0.7
BLOCK_TTL_SECONDS=3600
AGENT_COOLDOWN_SECONDS=30
MAX_AGENT_CONCURRENCY=4
AGENT_QUEUE_SIZE=1000

# Admin dashboard / API token (header X-Admin-Token, or ?token= once to set the session cookie)
ADMIN_TOKEN=change-me

# Use X-Forwarded-For as the client IP; enable only behind a trusted load balancer
TRUST_FORWARDED_FOR=false

# Max request body bytes accepted and forwarded
MAX_BODY_BYTES=1048576

# Cap on security events retained for the dashboard
MAX_EVENTS=500

# Vector store (falls back to in-memory if Chroma is unavailable)
CHROMA_DIR=data/chroma
ENABLE_CHROMA=true
